# Supabase project URL (Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon or service-role key (Dashboard > Project Settings > API)
SUPABASE_KEY=your-anon-or-service-role-key

# RabbitMQ / CloudAMQP connection string
AMQP_URL=amqp://guest:guest@localhost:5672/

# Set true to run the worker pipeline without applying processed entities
DRY_RUN=false
