# ==============================================================================
# Frontend Environment Configuration (.env)
# Copy this file to .env in the frontend directory before running the application:
#   cp .env.example .env
# ==============================================================================

# Supabase Project URL
# Where to find in Supabase:
#   Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anon (Public) Key
# Where to find in Supabase:
#   Dashboard -> Project Settings -> API -> Project API Keys -> anon (public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Base URL (for /api/auth/sync and backend API services)
VITE_BACKEND_URL=http://localhost:8080
