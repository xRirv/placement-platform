# ==============================================================================
# Backend Environment Configuration (.env)
# Copy this file to .env in the backend directory before running the application:
#   cp .env.example .env
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Transaction Pooler)
# Where to find in Supabase:
#   Dashboard -> Project Settings -> Database -> Connection String (URI / JDBC)
# Note: Use pooler URL (port 5432 or 6543) or direct connection. Include sslmode=require if needed.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# JPA / Hibernate DDL behavior ('update' for automatic schema migration in dev, 'none' or 'validate' for prod)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Supabase JWT Authentication / OAuth2 Resource Server
# Where to find in Supabase:
#   Dashboard -> Project Settings -> API -> Project URL & JWT Settings
# Issuer URI format: https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_ISSUER_URI=https://<your-project-ref>.supabase.co/auth/v1
# JWKS Set URI format: https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWK_SET_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Allowed Frontend URLs for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Optional / Legacy aliases supported by application.yml:
# SUPABASE_DB_URL=jdbc:postgresql://<your-host>:5432/postgres
# SUPABASE_DB_USER=postgres.<your-project-ref>
# SUPABASE_DB_PASSWORD=your-supabase-db-password
# SUPABASE_AUTH_ISSUER_URI=https://<your-project-ref>.supabase.co/auth/v1
# SUPABASE_AUTH_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Team B AI service (internal). Must match INTERNAL_API_KEY in Team B's .env
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me
