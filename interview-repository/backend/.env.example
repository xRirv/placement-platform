# Supabase Configuration
# Get these from your Supabase project settings (Settings > API)

# Database Connection (Settings > Database > Connection pooling)
SUPABASE_DB_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Supabase Client (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth/JWT (Settings > API > JWT Secret)
SUPABASE_AUTH_ISSUER_URI=https://your-project.supabase.co/auth/v1
SUPABASE_AUTH_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Application
JWT_SECRET=your-jwt-secret-at-least-32-chars
CLIENT_URL=http://localhost:5173